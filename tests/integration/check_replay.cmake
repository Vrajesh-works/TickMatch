# Runs tickmatch_replay on a LOBSTER file and checks its JSON summary.
# Inputs: REPLAY (binary), INPUT (message file), MODE, OUT (summary path).
execute_process(
    COMMAND ${REPLAY} --input ${INPUT} --mode ${MODE} --check-every 1000 --summary-json ${OUT} --quiet
    RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "tickmatch_replay exited with ${rc}")
endif()
file(READ ${OUT} json)

string(JSON ok GET ${json} invariants_ok)
string(JSON lines GET ${json} lines)
string(JSON malformed GET ${json} malformed)
string(JSON messages GET ${json} messages)
string(JSON fills GET ${json} fills)
string(JSON execs GET ${json} executions)
string(JSON matched GET ${json} executions_matched)
string(JSON unknown GET ${json} reject_unknown_id)
string(JSON dup GET ${json} reject_duplicate_id)
string(JSON invalid GET ${json} reject_invalid)
string(JSON p50 GET ${json} latency_ns book p50)
string(JSON p99 GET ${json} latency_ns book p99)

if(NOT ok)
    message(FATAL_ERROR "book invariants violated")
endif()
if(NOT malformed EQUAL 0 OR NOT messages EQUAL lines)
    message(FATAL_ERROR "expected every line to map to a request: lines=${lines} messages=${messages} malformed=${malformed}")
endif()
if(NOT unknown EQUAL 0 OR NOT dup EQUAL 0 OR NOT invalid EQUAL 0)
    message(FATAL_ERROR "unexpected rejects: unknown=${unknown} duplicate=${dup} invalid=${invalid}")
endif()
if(execs EQUAL 0 OR NOT matched EQUAL execs)
    message(FATAL_ERROR "executions did not replay against the named orders: ${matched}/${execs}")
endif()
if(NOT fills GREATER_EQUAL execs)
    message(FATAL_ERROR "fills (${fills}) fewer than executions (${execs})")
endif()
if(p50 EQUAL 0 OR p99 LESS p50)
    message(FATAL_ERROR "implausible latency percentiles p50=${p50} p99=${p99}")
endif()
message(STATUS "${MODE}: ${messages} messages, ${fills} fills, executions ${matched}/${execs}, p50=${p50}ns p99=${p99}ns")
